# Copy to .env.local for local dev. Never commit .env.local.
# In production these are set in Vercel project env settings.

# --- Clerk ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/inbox
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/inbox

# --- Postgres (Vercel Marketplace -> Neon auto-injects these) ---
# Pooled connection for app queries.
DATABASE_URL=
# Unpooled connection for migrations (drizzle-kit). pgBouncer can't run DDL.
DATABASE_URL_UNPOOLED=

# --- Sentry ---
NEXT_PUBLIC_SENTRY_DSN=

# --- Inbound email domain ---
# Empty in Week 1. Set to e.g. "inbox.firstresponder.app" once domain is live.
INBOUND_EMAIL_DOMAIN=
